    sd.getRange(1, c - 1).setValue('SHEILA ISEE — ' + k + ' SUMMARY');
    sd.getRange(2, c - 1).setValue('Metric');
    sd.getRange(2, c).setValue('Value');
    sd.getRange(3, c - 1, 13, 1).setFormula(
      '=IFERROR(IMPORTRANGE("' + url + '","SYSTEM SUMMARY!A3:A15"),"")');
    sd.getRange(3, c).setFormula(
      '=IFERROR(IMPORTRANGE("' + url + '","SYSTEM SUMMARY!B3:B15"),"awaiting access")');
    wrote++;
    SpreadsheetApp.flush();
  }
  out.push('wired ' + wrote + ' subject feeds (VR, QR, MA, RC, Essay, Mock)');
  out.push('ACTION NEEDED: open the Hub and click "Allow access" on each IMPORTRANGE prompt');
  var m = out.join(' | '); Logger.log(m); return m;
}

/* ---- the coverage gate currently measures itself ------------------------

   READINESS!B6 reads:
     IF('SKILL DATA'!O8=0,"Not enough evidence",
        COUNTIF('SKILL DATA'!D3:D292,"*Taught*")&" / "&'SKILL DATA'!O8&" ...")
   and 'SKILL DATA'!O8 is COUNTIF(C3:C292,"<>") — the number of rows that
   happen to be listed. Numerator and denominator come from the same imported
   table, so it reports "n / n" and can never show a gap. Coverage has to be
   measured against a planned inventory instead.                          */

var PLANNED_DOMAINS = [
  ['VR','Synonyms'],['VR','Sentence completion'],['VR','Word parts and roots'],
  ['VR','Connotation and tone'],['VR','Multiple meanings in context'],
  ['QR','Ratio, rate and proportion'],['QR','Fractions and decimals'],
  ['QR','Percent'],['QR','Number properties and factors'],['QR','Patterns and sequences'],
  ['QR','Measurement and geometry'],['QR','Data, average and probability'],
  ['QR','Estimation and number sense'],['QR','Algebraic reasoning'],
  ['MA','Whole-number operations'],['MA','Fractions'],['MA','Decimals'],['MA','Percent'],
  ['MA','Order of operations'],['MA','Perimeter and area'],['MA','Angles and geometry'],
  ['MA','Volume and measurement'],['MA','Data, mean and median'],['MA','Probability'],
  ['MA','Coordinates'],['MA','Algebra'],
  ['RC','Main idea'],['RC','Supporting detail/evidence'],['RC','Inference'],
  ['RC','Vocabulary in context'],['RC','Organization/logic'],['RC','Tone/style/figurative language'],
  ['Essay','Prompt interpretation'],['Essay','Idea generation'],['Essay','Organization'],
  ['Essay','Specific detail'],['Essay','Revision and conventions'],['Essay','Timed completion']
];

function fixCoverageGate() {
  var ss = SpreadsheetApp.openById(HUB_ID);
  var sd = ss.getSheetByName('SKILL DATA');

  // Park the planned inventory in a clearly-labelled block well clear of the
  // imported table (which occupies A:M, rows 3-292).
  var top = 300;
  if (sd.getMaxRows() < top + PLANNED_DOMAINS.length + 2) {
    sd.insertRowsAfter(sd.getMaxRows(), top + PLANNED_DOMAINS.length + 2 - sd.getMaxRows());
  }
  sd.getRange(top, 1).setValue('PLANNED DOMAIN INVENTORY — the denominator for coverage');
  sd.getRange(top, 2).setValue('Edit this list when the syllabus changes, not the gate formula.');
  sd.getRange(top + 1, 1, 1, 3).setValues([['Category', 'Planned domain', 'Taught?']]);
  var rows = PLANNED_DOMAINS.map(function (d) { return [d[0], d[1], '']; });
  sd.getRange(top + 2, 1, rows.length, 3).setValues(rows);

  // Taught? = does any imported skill row for this category mention the domain
  for (var i = 0; i < rows.length; i++) {
    var r = top + 2 + i;
    sd.getRange(r, 3).setFormula(
      '=IF(COUNTIFS($A$3:$A$292,$A' + r + ',$C$3:$C$292,"*"&$B' + r + '&"*")>0,"Taught",' +
      'IF(COUNTIFS($A$3:$A$292,$A' + r + ',$D$3:$D$292,"*Taught*")>0,"Partial","Not yet"))');
  }
  var first = top + 2, last = top + 1 + rows.length;
  sd.getRange(top, 15).setValue('planned_total');
  sd.getRange(top, 16).setFormula('=COUNTA($B$' + first + ':$B$' + last + ')');
  sd.getRange(top + 1, 15).setValue('planned_taught');
  sd.getRange(top + 1, 16).setFormula('=COUNTIF($C$' + first + ':$C$' + last + ',"Taught")');
  SpreadsheetApp.flush();

  var rd = ss.getSheetByName('READINESS');
  rd.getRange('B6').setFormula(
    '=LET(t,\'SKILL DATA\'!P' + top + ',d,\'SKILL DATA\'!P' + (top + 1) + ',' +
    'IF(t=0,"Not enough evidence",d&" / "&t&" planned domains taught"))');
  rd.getRange('F6').setValue(
    'Denominator is the planned domain inventory on SKILL DATA, not the imported list. ' +
    'A domain with no practice evidence shows as a gap.');
  rd.getRange('E6').setValue(new Date());
  SpreadsheetApp.flush();

  var m = 'coverage gate rebuilt against ' + rows.length + ' planned domains (SKILL DATA row '
        + top + '+); READINESS!B6 now reads taught/planned';
  Logger.log(m); return m;
}

