/* ================= PART 5 — Mock workbook content ========================

Two sets of edits, both embedded here so nothing depends on the repo push.

  content : the reviewed fixes from the 2026-08-30 mock review — the
            out-of-level items (circumference, circle area, radicals,
            compound probability, octagon angles), the duplicate-option
            item, and the ambiguous verbal items.

  rc      : removes a mechanical tell the 2026-08-30 review missed. It
            checked answer-letter distribution but not option length: the
            correct answer was the strictly longest option in 77 of the 100
            Reading items and the shortest in 1. Always picking the longest
            choice scored about 77% without reading a passage, which made
            mock Reading scores meaningless. Distractors were lengthened and
            padded keys trimmed; no key text gained meaning and no correct
            answer moved. Now 21% longest / 20% shortest, against 25% chance.

Idempotent: a cell already holding the target value is skipped.
=========================================================================== */

var MOCK_ID = '1LDQEe_NeQUTk_1gMaVXzhDcJgQLb3mPvm7vO8Kseg00';

function applyMockEdits_(which) {
  var blob = Utilities.newBlob(Utilities.base64Decode(B_MOCK), 'application/x-gzip', 'm.gz');
  var data = JSON.parse(Utilities.ungzip(blob).getDataAsString('UTF-8'))[which];
  var ss = SpreadsheetApp.openById(MOCK_ID);
  var t0 = new Date().getTime(), wrote = 0, same = 0, missing = {}, i = 0;

  for (; i < data.length; i++) {
    if (new Date().getTime() - t0 > BUDGET) break;
    var sh = ss.getSheetByName(data[i][0]);
    if (!sh) { missing[data[i][0]] = 1; continue; }
    var rg = sh.getRange(data[i][1]);
    if (String(rg.getValue()) === String(data[i][2])) { same++; continue; }
    rg.setNumberFormat('@');
    rg.setValue(data[i][2]);
    wrote++;
    if (wrote % 120 === 0) SpreadsheetApp.flush();
  }
  SpreadsheetApp.flush();
  var m = which + ': wrote ' + wrote + ', already correct ' + same +
          ', processed ' + i + '/' + data.length +
          (i < data.length ? ' — PAUSED, run again to continue' : ' — complete');
  var miss = Object.keys(missing);
  if (miss.length) m += ' | missing sheets: ' + miss.join(',');
  Logger.log(m); return m;
}

function fixMockContent()        { return applyMockEdits_('content'); }
function fixMockReadingOptions() { return applyMockEdits_('rc'); }

/** Read-only: is the Reading length tell actually gone in the live workbook? */
function auditMockReading() {
  var ss = SpreadsheetApp.openById(MOCK_ID), lo = 0, sh_ = 0, n = 0;
  var AK = ss.getSheetByName('ANSWER KEY').getDataRange().getValues();
  var key = {};
  for (var r = 1; r < AK.length; r++) if (AK[r][0]) key[String(AK[r][0]).trim()] = AK[r][5];
  ['DIAGNOSTIC', 'MOCK 1', 'MOCK 2', 'MOCK 3'].forEach(function (name) {
    var v = ss.getSheetByName(name).getDataRange().getValues();
    for (var r = 17; r < v.length; r++) {
      var id = String(v[r][0] || '').trim();
      if (!/^(DGN|M0\d)-RC-\d{3}$/.test(id) || !key[id]) continue;
      var opts = [v[r][5], v[r][6], v[r][7], v[r][8]].map(function (x) { return String(x || '').length; });
      var k = opts['ABCD'.indexOf(key[id])];
      var mx = Math.max.apply(null, opts), mn = Math.min.apply(null, opts);
      var cmx = 0, cmn = 0;
      opts.forEach(function (o) { if (o === mx) cmx++; if (o === mn) cmn++; });
      if (k === mx && cmx === 1) lo++;
      if (k === mn && cmn === 1) sh_++;
      n++;
    }
  });
  var m = 'mock RC ' + n + ' items: key longest ' + Math.round(lo / n * 100) +
          '%, shortest ' + Math.round(sh_ / n * 100) + '% (chance 25%; was 77% / 1%)';
  Logger.log(m); return m;
}


var B_VRFIX = '';

/* ================= PART 6 — remove a giveaway in VR weeks 2-4 =============

The 2026-08-31 subject review found that in the VR September bank, wherever
exactly one option was a phrase rather than a single word, that option was the
answer 22 times out of 23. A student who noticed could score 96% on those items
without knowing any of the words. That defect was never fixed and is still live.

This rewrites the single-word distractors on the 20 affected items in weeks 2-4
so several options are phrases. No key text changes and no correct answer moves;
only wrong options are edited. Afterwards the key is never the odd one out.

WEEK 1 IS DELIBERATELY EXCLUDED. Sheila has already answered and submitted those
items; changing the option text under a recorded answer would make her review
disagree with what she actually saw. Its three affected items stay as they were.

Only columns C-F (the four options) are written. Column G holds her answers and
is never touched.
=========================================================================== */

function fixVRPhraseTell() {
  var data = JSON.parse(Utilities.ungzip(Utilities.newBlob(
      Utilities.base64Decode(B_VRFIX), 'application/x-gzip', 'v.gz')).getDataAsString('UTF-8'));
  var ss = SpreadsheetApp.openById(CFG.VR.id);
  var wrote = 0, same = 0, guard = 0;
  for (var i = 0; i < data.length; i++) {
    if (data[i][0] === 'Sep VR W1') { guard++; continue; }        // belt and braces
    var sh = ss.getSheetByName(data[i][0]);
    if (!sh) continue;
    var rg = sh.getRange(data[i][1]);
    if (String(rg.getValue()) === String(data[i][2])) { same++; continue; }
    rg.setNumberFormat('@');
    rg.setValue(data[i][2]);
    wrote++;
  }
  SpreadsheetApp.flush();
  var m = 'VR options rewritten: ' + wrote + ' cells, ' + same + ' already correct'
        + (guard ? ', ' + guard + ' week-1 cells refused by guard' : '');
  Logger.log(m); return m;
}

/** Read-only: is the giveaway actually gone in the live workbook? */
function auditVRPhraseTell() {
  var ss = SpreadsheetApp.openById(CFG.VR.id), out = [];
  ['Sep VR W1', 'Sep VR W2', 'Sep VR W3', 'Sep VR W4'].forEach(function (name) {
    var sh = ss.getSheetByName(name);
    if (!sh) return;
    var v = sh.getDataRange().getValues(), hits = 0, keyed = 0;
    for (var r = 29; r < v.length; r++) {
      var opts = [v[r][2], v[r][3], v[r][4], v[r][5]].map(function (x) { return String(x || '').trim(); });
      var key = String(v[r][9] || '').trim();
      if (opts.some(function (o) { return !o; }) || 'ABCD'.indexOf(key) < 0) continue;
      var multi = [];
      opts.forEach(function (o, i) { if (o.split(/\s+/).length > 1) multi.push(i); });
      if (multi.length === 1) { hits++; if ('ABCD'[multi[0]] === key) keyed++; }
    }
    out.push(name.replace('Sep VR ', '') + ' ' + keyed + '/' + hits);
  });
  var m = 'key is the only multi-word option — ' + out.join(', ') +
          '  (was W1 3/3, W2 6/6, W3 10/10, W4 4/4)';
  Logger.log(m); return m;
}
