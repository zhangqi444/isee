/**
 * Sheila ISEE — build weeks 5–8 for VR, QR, MA and RC (2026-09-01).
 *
 * Creates 16 new week tabs by COPYING an existing clean week tab, so every
 * formula, checkbox, format and conditional rule comes along, then overwrites
 * only the content cells. Appends matching answer-key rows.
 *
 * SAFETY: it never reads or writes a learner-input column, and it never
 * touches "Sep MA W1" or "Sep VR W1", which hold Sheila's completed work.
 * Each week is stamped in AZ1; a stamped week is skipped, so this is safe to
 * re-run and resumes cleanly after the 6-minute limit.
 */
var STAMP = 'built-2026-09-01';
var BUDGET = 4.5 * 60 * 1000;

var CFG = {
  MA: {id:'1JMPIKXdVoz9BOjMUMwYhnITLFwcrJtwEoCjKP5r26GM', tpl:'Sep MA W2',
