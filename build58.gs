function dec_(b64) {
  var blob = Utilities.newBlob(Utilities.base64Decode(b64), 'application/x-gzip', 'p.gz');
  return JSON.parse(Utilities.ungzip(blob).getDataAsString('UTF-8'));
}

/** Grow a sheet's grid so a target row/column actually exists. */
function ensure_(sh, rows, cols) {
  if (rows && sh.getMaxRows() < rows) sh.insertRowsAfter(sh.getMaxRows(), rows - sh.getMaxRows());
  if (cols && sh.getMaxColumns() < cols) sh.insertColumnsAfter(sh.getMaxColumns(), cols - sh.getMaxColumns());
  return sh;
}

/** Copy the template tab, name it, park it after the last week tab. */
function mkTab_(ss, cfg, name) {
  var sh = ss.getSheetByName(name);
  if (sh) return sh;
  sh = ss.getSheetByName(cfg.tpl).copyTo(ss).setName(name);
  var anchor = ss.getSheetByName(cfg.after);
  ss.setActiveSheet(sh);
  ss.moveActiveSheet(anchor ? anchor.getIndex() + 1 : ss.getSheets().length);
  ensure_(sh, 0, 52);                       // AZ1 is the build stamp
  return sh;
}

/** Write a row of choices as TEXT so Sheets cannot turn 1/2 or 16:25 into a date. */
function putChoices_(sh, row, col, arr) {
  var rg = sh.getRange(row, col, 1, arr.length);
  rg.setNumberFormat('@');
  rg.setValues([arr]);
}


