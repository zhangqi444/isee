/* Subject week -> the dates it now covers. Weeks 1-3 run back to back; the
   Hub's week 4 is the split-baseline mock week, so subject week 4 lands on
   Hub week 5, and so on. Sheila submitted MA and VR week 1 on 31 Aug, so
   week 1 is dated to the week she actually started. */
var WEEKDATES = ['Aug 31–Sep 6','Sep 7–13','Sep 14–20','Sep 28–Oct 4',
                 'Oct 5–11','Oct 12–18','Nov 9–15','Nov 16–22'];

/* Hub week (1-12) -> subject week (1-8), 0 = a mock or correction week. */
var HUB2SUB = [1,2,3,0,4,5,6,0,0,0,7,8];

var SUBJ = {
  VR:{id:CFG.VR.id, pre:['Sep VR W1','Sep VR W2','Sep VR W3','Sep VR W4','Oct VR W5','Oct VR W6','Nov VR W7','Nov VR W8']},
  QR:{id:CFG.QR.id, pre:['Sep QR W1','Sep QR W2','Sep QR W3','Sep QR W4','Oct QR W5','Oct QR W6','Nov QR W7','Nov QR W8']},
  MA:{id:CFG.MA.id, pre:['Sep MA W1','Sep MA W2','Sep MA W3','Sep MA W4','Oct MA W5','Oct MA W6','Nov MA W7','Nov MA W8']},
  RC:{id:CFG.RC.id, pre:['Sep RC W1','Sep RC W2','Sep RC W3','Sep RC W4','Oct RC W5','Oct RC W6','Nov RC W7','Nov RC W8']},
  Essay:{id:ESSAY_ID, pre:['Essay W1','Essay W2','Essay W3','Essay W4','Essay W5','Essay W6','Essay W7','Essay W8']}
};

/** Re-date weeks 1-4: replace only the leading date range in A2, keep the focus text. */
function redatePlan() {
  var out = [];
  ['VR','QR','MA'].forEach(function (k) {
    var ss = SpreadsheetApp.openById(SUBJ[k].id), n = 0;
    for (var i = 0; i < 4; i++) {
      var sh = ss.getSheetByName(SUBJ[k].pre[i]);
      if (!sh) { out.push('MISSING ' + SUBJ[k].pre[i]); continue; }
      var cell = sh.getRange('A2');
      var v = String(cell.getValue() || '');
      var dot = v.indexOf('•');
      var want = WEEKDATES[i] + (dot >= 0 ? ' ' + v.slice(dot) : '');
      if (v !== want) { cell.setValue(want); n++; }
    }
    out.push(k + ': ' + n + ' subtitles re-dated');
    SpreadsheetApp.flush();
  });
  out.push('RC: no date line on week tabs, nothing to re-date');

  // Hub STUDY PLAN: shift every plan date back one week so week 1 is 31 Aug.
  var hub = SpreadsheetApp.openById(HUB_ID), sp = hub.getSheetByName('STUDY PLAN');
  var rng = sp.getRange(9, 2, 72, 1), vals = rng.getValues(), moved = 0;
  var first = vals[0][0];
  if (first instanceof Date && first.getMonth() === 8 && first.getDate() === 7) {
    for (var i = 0; i < vals.length; i++) {
      var d = vals[i][0];
      if (d instanceof Date) { vals[i][0] = new Date(d.getTime() - 7 * 864e5); moved++; }
    }
    rng.setValues(vals);
  }
  sp.getRange('A4').setValue('W1 begins August 31, 2026. A full mock replaces normal '
    + 'section work; it is never added on top. Rest, correction, and recovery gates always win.');
  SpreadsheetApp.flush();
  out.push('hub: shifted ' + moved + ' dates, first=' +
    Utilities.formatDate(sp.getRange(9,2).getValue(),'UTC','yyyy-MM-dd') + ' last=' +
    Utilities.formatDate(sp.getRange(80,2).getValue(),'UTC','yyyy-MM-dd'));

  // Name the exact tab to open on each subject day, prefixed in [brackets].
  var pw = sp.getRange(9, 5, 72, 3).getValues();   // E=subject, F=objective, G=planned work
  var tagged = 0;
  for (var r = 0; r < 72; r++) {
    var subj = String(pw[r][0] || '').trim(), hw = HUB2SUB[Math.floor(r / 6)];
    if (!hw || !SUBJ[subj]) continue;
    var tab = SUBJ[subj].pre[hw - 1], cur = String(pw[r][2] || '');
    var body = cur.charAt(0) === '[' ? cur.slice(cur.indexOf(']') + 1).replace(/^\s+/, '') : cur;
    var want = '[' + tab + '] ' + body;
    if (cur !== want) { pw[r][2] = want; tagged++; }
  }
  sp.getRange(9, 5, 72, 3).setValues(pw);
  SpreadsheetApp.flush();
  out.push('hub: tagged ' + tagged + ' plan rows with their sheet');
  var m = out.join(' | '); Logger.log(m); return m;
}

