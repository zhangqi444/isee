/** Extend "Sessions completed" and "Sessions planned" to all eight weeks.
 *  Accuracy formulas are deliberately NOT touched — see the note it writes. */
function extendSubjectSummaries() {
  var out = [];
  ['VR', 'QR', 'MA', 'RC'].forEach(function (k) {
    var ss = SpreadsheetApp.openById(CFG[k].id), sum = ss.getSheetByName('SYSTEM SUMMARY');
    var tabs = WEEKTABS[k].filter(function (t) { return ss.getSheetByName(t); });
    var parts = [];
    tabs.forEach(function (t) {
      DONE[k].forEach(function (pat) {
        parts.push('N(' + (pat.indexOf('@') > -1
          ? pat.replace(/@/g, t)
          : '\'' + t + '\'!' + pat) + ')');
      });
    });
    sum.getRange('B5').setFormula('=' + parts.join('+'));
    sum.getRange('B6').setValue(tabs.length * DONE[k].length);
    sum.getRange('D6').setValue('Counts the ' + tabs.length + ' week tabs that exist.');
    out.push(k + ': ' + tabs.length + ' weeks, ' + (tabs.length * DONE[k].length) + ' sessions planned');
    SpreadsheetApp.flush();
  });
  out.push('NOTE: Overall/Timed accuracy still reference weeks 1-4 only — rebuild those by hand '
         + 'against the live formulas; they are too long to reconstruct safely from here.');
  var m = out.join(' | '); Logger.log(m); return m;
}

