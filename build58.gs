/* ---------------- MA / QR : same shape ---------------- */
function buildMAQR_(sub) {
  var cfg = CFG[sub], data = dec_(sub === 'MA' ? B_MA : B_QR);
  var ss = SpreadsheetApp.openById(cfg.id), out = [], t0 = Date.now();
  var ks = ensure_(ss.getSheetByName(cfg.key), cfg.keyRow + 120, 0);
  for (var wi = 0; wi < data.length; wi++) {
    var w = data[wi];
    if (Date.now() - t0 > BUDGET) { out.push('paused before ' + w.t); break; }
    var sh = mkTab_(ss, cfg, w.t);
    if (sh.getRange('AZ1').getValue() === STAMP) { out.push(w.t + ': already built'); continue; }
    sh.getRange(1, 1).setValue(w.ti);
    sh.getRange(2, 1).setValue(w.su);
    var keyRow = cfg.keyRow + wi * (cfg.blocks[0][1] - cfg.blocks[0][0] + 1
                                    + cfg.blocks[1][1] - cfg.blocks[1][0] + 1);
    var kr = keyRow, n = 0;
    for (var si = 0; si < w.s.length; si++) {
      var s = w.s[si], b = cfg.blocks[si];
      sh.getRange(cfg.head[si][0], 1).setValue(s.h);
      if (cfg.head[si][1]) sh.getRange(cfg.head[si][1], 1).setValue(s.i);
      for (var i = 0; i < s.it.length; i++) {
        var it = s.it[i], r = b[0] + i;
        sh.getRange(r, cfg.c.sk).setValue(it[0]);
        sh.getRange(r, cfg.c.q).setValue(it[2]);
        putChoices_(sh, r, cfg.c.ch, it[3]);
        sh.getRange(r, cfg.c.cor).setValue(it[4]);
        sh.getRange(r, cfg.c.ex).setValue(it[5]);
        sh.getRange(r, cfg.ansCol).clearContent();          // learner answer stays empty
        // answer-key mirror row
        var kv = (sub === 'MA')
          ? ['W' + w.w, 'S' + (si + 1), i + 1, it[0], it[4], it[2],
             it[3][0], it[3][1], it[3][2], it[3][3], it[5],
             sub + '-' + w.t.split(' ')[0].toUpperCase() + '-W' + w.w + '-S' + (si+1) + '-' + (i+1), it[1], '']
          : ['W' + w.w, 'S' + (si + 1), i + 1, it[0], it[4], it[5], it[2],
             sub + '-W' + w.w + '-S' + (si+1) + '-' + (i+1), sub, it[0], it[1], ''];
        var krg = ks.getRange(kr, 1, 1, kv.length);
        krg.setNumberFormat('@');
        krg.setValues([kv]);
        kr++; n++;
      }
      cfg.submits[si] && sh.getRange(cfg.submits[si], cfg.ansCol).setValue(false);
      SpreadsheetApp.flush();
    }
    sh.getRange('AZ1').setValue(STAMP);
    out.push(w.t + ': ' + n + ' items, key rows ' + keyRow + '-' + (kr - 1));
    SpreadsheetApp.flush();
  }
  var m = sub + ' | ' + out.join(' | ');
  Logger.log(m); return m;
}
function buildMA() { return buildMAQR_('MA'); }
function buildQR() { return buildMAQR_('QR'); }

/* ---------------- RC : correct + explanation are formulas into the key ------ */
function buildRC() {
  var cfg = CFG.RC, data = dec_(B_RC);
  var ss = SpreadsheetApp.openById(cfg.id), out = [], t0 = Date.now();
  var ks = ensure_(ss.getSheetByName(cfg.key), 112, 0);
  for (var wi = 0; wi < data.length; wi++) {
    var w = data[wi];
    if (Date.now() - t0 > BUDGET) { out.push('paused before ' + w.t); break; }
    var sh = mkTab_(ss, cfg, w.t);
    if (sh.getRange('AZ1').getValue() === STAMP) { out.push(w.t + ': already built'); continue; }
    sh.getRange(1, 1).setValue(w.ti);
    var keyRow = cfg.keyRow + wi * 12, kr = keyRow, n = 0;
    for (var si = 0; si < w.s.length; si++) {
      var s = w.s[si], b = cfg.blocks[si];
      sh.getRange(cfg.sessHead[si], 1).setValue(s.h);
      sh.getRange(cfg.passRow[si], 1).setValue(s.p);
      var title = s.h.split('—')[1] ? s.h.split('—')[1].split('•')[0].trim() : w.t;
      for (var i = 0; i < s.it.length; i++) {
        var it = s.it[i], r = b[0] + i;
        sh.getRange(r, cfg.c.sk).setValue(it[0]);
        sh.getRange(r, cfg.c.q).setValue(it[2]);
        putChoices_(sh, r, cfg.c.ch, it[3]);
        sh.getRange(r, cfg.c.cor).setFormula(
          "=IF(OR(" + cfg.gate[si] + "),'" + cfg.key + "'!E" + kr + ',"")');
        sh.getRange(r, cfg.c.ex).setFormula(
          "=IF(OR(" + cfg.gate[si] + "),'" + cfg.key + "'!G" + kr + ',"")');
        var kv = ['W' + w.w, 'S' + (si + 1), i + 1, it[0], it[4], it[2], it[5],
                  title, 'RC-W' + w.w + '-S' + (si + 1) + '-Q' + (i + 1), 'RC', it[1],
                  it[3][0], it[3][1], it[3][2], it[3][3], '', 1];
        var krg = ks.getRange(kr, 1, 1, kv.length);
        krg.setNumberFormat('@');
        krg.setValues([kv]);
        kr++; n++;
      }
      sh.getRange(cfg.submits[si], cfg.ansCol).setValue(false);
      SpreadsheetApp.flush();
    }
    sh.getRange('AZ1').setValue(STAMP);
    out.push(w.t + ': ' + n + ' items, key rows ' + keyRow + '-' + (kr - 1));
    SpreadsheetApp.flush();
  }
  var m = 'RC | ' + out.join(' | ');
  Logger.log(m); return m;
}

/* ---------------- VR : session 1 is open response, 2 and 3 are MC ---------- */
function buildVR() {
  var cfg = CFG.VR, data = dec_(B_VR);
  var ss = SpreadsheetApp.openById(cfg.id), out = [], t0 = Date.now();
  var ks = ensure_(ss.getSheetByName(cfg.key), 340, 0);
  for (var wi = 0; wi < data.length; wi++) {
    var w = data[wi];
    if (Date.now() - t0 > BUDGET) { out.push('paused before ' + w.t); break; }
    var sh = mkTab_(ss, cfg, w.t);
    if (sh.getRange('AZ1').getValue() === STAMP) { out.push(w.t + ': already built'); continue; }
    sh.getRange(1, 1).setValue(w.ti);
    sh.getRange(2, 1).setValue(w.su);
    var keyRow = cfg.keyRow + wi * 37, kr = keyRow, n = 0;
    for (var si = 0; si < w.s.length; si++) {
      var s = w.s[si], b = cfg.blocks[si];
      sh.getRange(cfg.head[si][0], 1).setValue(s.h);
      if (cfg.head[si][1]) sh.getRange(cfg.head[si][1], 1).setValue(s.i);
      for (var i = 0; i < s.it.length; i++) {
        var it = s.it[i], r = b[0] + i;
        if (si === 0) {                       // word + task, no key row
          sh.getRange(r, cfg.c.w).setValue(it[0]);
          sh.getRange(r, cfg.c.task).setValue(it[1]);
          continue;
        }
        sh.getRange(r, cfg.c.q).setValue(it[2]);
        putChoices_(sh, r, cfg.c.ch, it[3]);
        sh.getRange(r, cfg.c.cor).setValue(it[4]);
        sh.getRange(r, cfg.c.word).setValue(it[0]);
        var krg = ks.getRange(kr, 1, 1, 5);
        krg.setNumberFormat('@');
        krg.setValues([['W' + w.w, 'S' + (si + 1), i + 1, it[4], it[0]]]);
        kr++; n++;
      }
      sh.getRange(cfg.submits[si], 7).setValue(false);
      SpreadsheetApp.flush();
    }
    sh.getRange('AZ1').setValue(STAMP);
    out.push(w.t + ': ' + n + ' MC items, key rows ' + keyRow + '-' + (kr - 1));
    SpreadsheetApp.flush();
  }
  var m = 'VR | ' + out.join(' | ');
  Logger.log(m); return m;
}

/** Sanity check the payloads decode before anything is written. */
function selfTest() {
  var r = [];
  [['MA', B_MA], ['QR', B_QR], ['RC', B_RC], ['VR', B_VR]].forEach(function (p) {
    var d = dec_(p[1]), n = 0;
    d.forEach(function (w) { w.s.forEach(function (s) { n += s.it.length; }); });
    r.push(p[0] + ': ' + d.length + ' weeks, ' + n + ' rows, tabs=' +
           d.map(function (w) { return w.t; }).join('/'));
  });
  var m = r.join(' | ');
  Logger.log(m); return m;
}

